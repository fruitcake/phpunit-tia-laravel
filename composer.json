{
    "name": "fruitcake/phpunit-tia-laravel",
    "description": "Laravel integration for phpunit-tia: links tests to the views they render and the migrations of the tables they query",
    "keywords": [
        "laravel",
        "phpunit",
        "testing",
        "tia",
        "test impact analysis"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Barry vd. Heuvel",
            "email": "barry@fruitcake.nl"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "jasonmccreary/phpunit-tia": "dev-main"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^3.5",
        "laravel/pint": "^1.24",
        "livewire/livewire": "^4.4",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.2.6",
        "symfony/process": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Fruitcake\\PhpUnitTia\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fruitcake\\PhpUnitTia\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "lint": "pint"
    },
    "suggest": {
        "livewire/livewire": "Links Livewire 4 single-file and multi-file components (^4.0)",
        "inertiajs/inertia-laravel": "Links Inertia page components"
    }
}
